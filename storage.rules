rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function schoolMember(schoolId) {
      return signedIn()
        && userProfile().schoolId == schoolId
        && userProfile().status == 'active';
    }

    match /schools/{schoolId}/{allPaths=**} {
      allow read: if schoolMember(schoolId) && 'document.read' in userProfile().permissions;
      allow write: if schoolMember(schoolId) && 'document.manage' in userProfile().permissions;
    }
  }
}
